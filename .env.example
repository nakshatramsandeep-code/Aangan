# Every integration runs in MOCK mode until its keys are filled in. /setup shows which are live.

# --- App ---
APP_URL=http://localhost:3000
# Optional: if set, the dashboard asks for this password (username: anything)
DASHBOARD_PASSWORD=
# Shared secret Vaani sends on /api/vaani/webhook (as ?secret=) and /api/qualify
VAANI_WEBHOOK_SECRET=

# --- Neon (call log). Without it, calls are kept in .data/calls.json (local only) ---
DATABASE_URL=

# --- Gemini Flash (triage). Without it, a rule-based fallback is used ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- HubSpot (private app token: crm.objects.contacts + deals write) ---
HUBSPOT_TOKEN=
HUBSPOT_DEAL_STAGE=appointmentscheduled
HUBSPOT_PIPELINE=default

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Rules owned by Nikhil ---
# "Clearly below any project": a volunteered budget under this fails criterion 4
BUDGET_FLOOR_LAKH=3
# Studio hours (IST). Weekends count as after-hours.
OPEN_HOUR=10
CLOSE_HOUR=19

# --- Cost model (replace the placeholders with real rates) ---
VAANI_COST_PER_MIN_INR=6
GEMINI_INPUT_USD_PER_M=0.30
GEMINI_OUTPUT_USD_PER_M=2.50
USD_INR=88
# Vercel + Neon + other flat monthly costs, spread across calls on the dashboard
FIXED_MONTHLY_COST_INR=0
